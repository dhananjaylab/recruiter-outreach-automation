# --- Python bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Distribution / packaging ---
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.env/          # directory (the .env *file* is intentionally NOT ignored here)

# --- Testing & coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
junit*.xml

# --- Type checkers ---
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# --- Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Project-specific runtime data ---
# SQLite database and per-run CSV reports are generated at runtime
data/*.db
reports/*.csv

# The .env file holds real credentials — never commit it
.env

# Sphinx build output
docs/_build/
