# ============================================================
# Recruiter Outreach Automation — environment configuration
# Copy this file to .env and fill in your details.
# ============================================================

# --- Identity ---
EMAIL_USER="your-email@gmail.com"
SENDER_NAME="Your Name"

# --- Email provider ---
# "gmail_oauth" (default, recommended): sends via the Gmail API using an
#   OAuth2 refresh token — no password stored anywhere. Connect an account
#   via GET /auth/google/login (or the Streamlit sidebar "Connect Gmail").
# "smtp": legacy fallback using an app password. Set EMAIL_PASSWORD below
#   and EMAIL_PROVIDER=smtp if you don't want to set up Google Cloud OAuth.
EMAIL_PROVIDER=gmail_oauth
MAIL_READER_PROVIDER=gmail_oauth

# --- Google OAuth2 (only used when EMAIL_PROVIDER/MAIL_READER_PROVIDER=gmail_oauth) ---
# 1. Create a Google Cloud project, enable the Gmail API.
# 2. Create an OAuth 2.0 Client ID of type "Web application".
# 3. Add GOOGLE_OAUTH_REDIRECT_URI below as an authorized redirect URI.
# 4. Download the client secret JSON and save it at GOOGLE_CLIENT_SECRETS_PATH.
# 5. Start the API (uvicorn recruiter_outreach.api.main:app) and visit
#    GET /auth/google/login once — GOOGLE_TOKEN_PATH is created automatically.
GOOGLE_CLIENT_SECRETS_PATH="credentials/client_secret.json"
GOOGLE_TOKEN_PATH="credentials/token.json"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# --- Legacy SMTP / IMAP (only used when EMAIL_PROVIDER=smtp / MAIL_READER_PROVIDER=imap) ---
# Gmail users: use an App Password (https://myaccount.google.com/apppasswords),
# not your regular password, for both SMTP and IMAP.
EMAIL_PASSWORD=""
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
IMAP_SERVER="imap.gmail.com"
IMAP_PORT=993

# --- Resume ---
# Prefer RESUME_LINK (a hosted copy, e.g. Google Drive/Notion/personal site).
# PDF attachments hurt deliverability — only use RESUME_PATH as a fallback.
RESUME_LINK=""
RESUME_PATH="path/to/Your_Resume.pdf"

# --- Templates ---
EMAIL_TEMPLATE_DIR="email_templates"
# Default outreach scenario when a recruiter row doesn't specify one.
# Options: cold, referral, post_application, informational_interview,
# event_followup, alumni (or a Role-based template like sde/mle/data_scientist).
DEFAULT_SCENARIO="cold"

# --- Sending & rate limits ---
# Smooths bursts WITHIN a single run (sliding window) — NOT the daily cap,
# see WARMUP_CEILING / DAILY_SEND_CAP_ENABLED below for that.
MAX_EMAIL_THREADS=5
MAX_EMAIL_RETRIES=3
EMAIL_CALLS_PER_PERIOD=10
EMAIL_PERIOD=60

# --- Domain / sender warm-up ---
# Ramps the TRUE daily send volume linearly from WARMUP_START_CAP up to
# WARMUP_CEILING over WARMUP_DAYS, enforced by DailySendGovernor against
# actual DB send counts (not just a rate-limiter setting).
WARMUP_ENABLED=true
WARMUP_START_CAP=15
WARMUP_DAILY_INCREMENT=10
WARMUP_DAYS=14
WARMUP_CEILING=150
DAILY_SEND_CAP_ENABLED=true

# --- Optimal send-window advisory ---
# 2026 deliverability research: Tue-Thu mid-morning outperforms Mon/Fri and
# off-hours sends. Advisory by default (surfaced in the UI); set
# SEND_WINDOW_ENFORCE=true to hard-block sends outside the window instead.
SEND_WINDOW_ENABLED=true
SEND_WINDOW_ENFORCE=false
SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=11
SEND_WINDOW_DAYS="Tue,Wed,Thu"

# --- Follow-up sequence ---
# 3-touch sequence (bump -> add value -> low-pressure close) spaced
# FOLLOWUP_DELAY_DAYS apart consistently outperforms a single nudge.
FOLLOWUP_ENABLED=true
FOLLOWUP_DELAY_DAYS=4
MAX_FOLLOWUPS=3

# --- Compliance ---
# Shown in the unsubscribe footer of every email, e.g. "replying to this email"
UNSUBSCRIBE_CONTACT="replying to this email"

# --- LLM (optional; used for PDF-fallback extraction and/or personalization) ---
ANTHROPIC_API_KEY=""
LLM_PERSONALIZATION_ENABLED=false

# --- Pre-send verification ---
VERIFY_MX=true
# SMTP RCPT probing is best-effort: most networks block outbound port 25,
# and many mail servers accept-then-bounce, so treat this as a bonus signal.
VERIFY_SMTP_RCPT=false

# --- Storage ---
DB_PATH="data/outreach.db"
REPORTS_DIR="reports"

# --- API (FastAPI) ---
MAX_UPLOAD_SIZE_MB=10
PREVIEW_TTL_SECONDS=1800
