# ============================================================
# Recruiter Outreach Automation — environment configuration
# Copy this file to .env and fill in your details.
# ============================================================

# --- Sender credentials ---
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-google-app-password"
SENDER_NAME="Your Name"

# --- SMTP (sending) ---
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587

# --- IMAP (used for bounce/reply tracking — usually same mailbox) ---
IMAP_SERVER="imap.gmail.com"
IMAP_PORT=993

# --- Resume ---
# Prefer RESUME_LINK (a hosted copy, e.g. Google Drive/Notion/personal site).
# PDF attachments hurt deliverability — only use RESUME_PATH as a fallback.
RESUME_LINK=""
RESUME_PATH="path/to/Your_Resume.pdf"

# --- Templates ---
EMAIL_TEMPLATE_DIR="email_templates"

# --- Sending & rate limits ---
MAX_EMAIL_THREADS=5
MAX_EMAIL_RETRIES=3
# EMAIL_CALLS_PER_PERIOD acts as the *ceiling* once warm-up finishes.
EMAIL_CALLS_PER_PERIOD=10
EMAIL_PERIOD=60

# --- Domain / sender warm-up ---
# Ramps the daily send cap linearly from WARMUP_START_CAP up to
# EMAIL_CALLS_PER_PERIOD over WARMUP_DAYS, starting from the first send.
WARMUP_ENABLED=true
WARMUP_START_CAP=20
WARMUP_DAILY_INCREMENT=15
WARMUP_DAYS=14

# --- Follow-up sequence ---
FOLLOWUP_ENABLED=true
FOLLOWUP_DELAY_DAYS=5
MAX_FOLLOWUPS=1

# --- Compliance ---
# Shown in the unsubscribe footer of every email, e.g. "replying to this email"
UNSUBSCRIBE_CONTACT="replying to this email"

# --- LLM (optional; used for PDF-fallback extraction and/or personalization) ---
ANTHROPIC_API_KEY=""
LLM_PERSONALIZATION_ENABLED=false

# --- Pre-send verification ---
VERIFY_MX=true
# SMTP RCPT probing is best-effort: most networks block outbound port 25,
# and many mail servers accept-then-bounce, so treat this as a bonus signal.
VERIFY_SMTP_RCPT=false

# --- Storage ---
DB_PATH="data/outreach.db"
REPORTS_DIR="reports"
